# ==================================================================
#  Cấu hình backend đề tài 2 - copy thành file .env rồi sửa giá trị
#  (run_dev.bat / run_dev.sh tự copy nếu chưa có .env)
# ==================================================================

# ---------- App ----------
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# 0.0.0.0 để Raspberry Pi trong cùng mạng gọi được
HOST=0.0.0.0
PORT=8000
# vd: http://localhost:5500,http://192.168.1.10:8000
CORS_ORIGINS=*
TIMEZONE=Asia/Ho_Chi_Minh

# ---------- Database ----------
# Dev (không cần cài gì):  sqlite+aiosqlite:///./data/iot_detai2.db
# PostgreSQL:              postgresql+asyncpg://iot:iot_password@localhost:5432/iot_detai2
DATABASE_URL=sqlite+aiosqlite:///./data/iot_detai2.db
# false = tạo bảng bằng "alembic upgrade head" (khuyên dùng); true = server tự tạo bảng khi khởi động
AUTO_CREATE_TABLES=false
DB_ECHO=false

# ---------- Đăng nhập dashboard (JWT) ----------
# Tạo chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
# chỉ dùng khi tạo tài khoản lần đầu
ADMIN_PASSWORD=admin123

# ---------- Thiết bị mặc định (tạo sẵn lúc khởi động) ----------
DEFAULT_DEVICE_UID=door-01
DEFAULT_DEVICE_NAME=Cửa thư viện
DEFAULT_DEVICE_LOCATION=Thư viện tầng 1
# Pi gửi trong header X-API-Key
DEFAULT_DEVICE_API_KEY=dev-door-01-key-change-me

# ---------- Nghiệp vụ ----------
# quá thời gian này không nhận tín hiệu -> offline + cảnh báo
DEVICE_OFFLINE_SECONDS=90
OFFLINE_CHECK_INTERVAL_SECONDS=15
# 2 lượt cách nhau < 1s chỉ tính 1 (0 = tắt, chỉ để Pi lọc)
SERVER_DEBOUNCE_SECONDS=1.0
# số lượt tối đa mỗi request gửi bù
MAX_BATCH_SIZE=500
# timestamp ở tương lai quá mức này -> lấy giờ server
MAX_CLOCK_SKEW_SECONDS=300

# ---------- MQTT (tùy chọn - mặc định thiết bị dùng HTTP) ----------
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=iot
MQTT_PASSWORD=iot_mqtt_password
MQTT_CLIENT_ID=iot-detai2-backend
MQTT_TOPIC_PREFIX=iot/devices

# ---------- Docker Compose (PostgreSQL) ----------
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot_detai2
