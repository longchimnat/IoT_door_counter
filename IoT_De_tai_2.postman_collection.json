              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Đặt lại số đếm (dashboard)",
      "item": [
        {
          "name": "Gửi lệnh reset_counter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/control",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{deviceId}}",
                "control"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"reset_counter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 202\", () => pm.response.to.have.status(202));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"commandId\", j.command.id);",
                  "pm.test(\"Server về 0\", () => pm.expect(j.count_today).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lịch sử lệnh",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/control-logs?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{deviceId}}",
                "control-logs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Raspberry Pi (X-API-Key)",
      "description": "Các API Pi gọi. Header X-API-Key = {{apiKey}}.",
      "item": [
        {
          "name": "Lấy trạng thái khi Pi khởi động",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "state"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi 1 lượt qua cửa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/passages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "passages"
              ]
            },
            "description": "event_id và thời gian tự sinh mỗi lần bấm Send.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"{{eventId}}\",\n      \"occurred_at\": \"{{nowIso}}\",\n      \"min_distance_cm\": 42.5,\n      \"baseline_cm\": 120.0,\n      \"duration_ms\": 480\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"eventId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"nowIso\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Nhận 1 lượt\", () => pm.expect(j.accepted).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi lại đúng lượt đó (giả lập gửi bù)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/passages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "passages"
              ]
            },
            "description": "Chạy ngay sau request trước: cùng event_id -> duplicates = 1.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"{{eventId}}\",\n      \"occurred_at\": \"{{nowIso}}\",\n      \"min_distance_cm\": 42.5,\n      \"baseline_cm\": 120.0,\n      \"duration_ms\": 480\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Bị coi là trùng, không đếm thêm\", () => { pm.expect(j.accepted).to.eql(0); pm.expect(j.duplicates).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Hai lần chắn cách nhau < 1 giây",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/passages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "passages"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"occurred_at\": \"{{t1}}\"\n    },\n    {\n      \"event_id\": \"{{$guid}}\",\n      \"occurred_at\": \"{{t2}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = Date.now() + 5000;",
                  "pm.collectionVariables.set(\"t1\", new Date(t).toISOString());",
                  "pm.collectionVariables.set(\"t2\", new Date(t + 400).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Chỉ tính 1 lượt\", () => { pm.expect(j.accepted).to.eql(1); pm.expect(j.debounced).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi telemetry (trạng thái phòng)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/telemetry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "telemetry"
              ]
            },
            "description": "Nếu vừa bấm reset trên web, pending_commands sẽ có lệnh reset_counter -> id lưu vào {{commandId}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_occupied\": true,\n  \"motion\": true,\n  \"distance_cm\": 119.4,\n  \"local_count\": 0,\n  \"extra\": {\n    \"cpu_temp\": 52.1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.pending_commands.length) pm.collectionVariables.set(\"commandId\", j.pending_commands[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Hỏi lệnh đang chờ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/commands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "commands"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const l = pm.response.json();",
                  "if (l.length) pm.collectionVariables.set(\"commandId\", l[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Xác nhận đã thực hiện lệnh (ack)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/device/commands/{{commandId}}/ack",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "device",
                "commands",
                "{{commandId}}",
                "ack"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"success\",\n  \"detail\": \"LCD da ve 0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sai API key -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
